# HOTEL EXPERIENCE — environment template
# Never commit real secrets.

# Browser / Vite (publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server / Vercel Functions
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_CONFIG_SECRET=
APP_PUBLIC_URL=

# Existing optional integrations. Copy only the ones used by your deployment.
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI/provider configuration belongs in the application settings
# or in server-only variables when required. Never expose private provider keys via VITE_*.
