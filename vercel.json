{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/control-checks",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/provider-drive-sync",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/catalogo",
      "destination": "/index.html"
    },
    {
      "source": "/catalogo/:path*",
      "destination": "/index.html"
    }
  ]
}
